{
  "name": "toolshop-hybrid-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Hybrid Playwright and Vibium automation for the Practice Software Testing Toolshop",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:hermetic": "playwright test tests/unit tests/mocked",
    "test:hybrid:hermetic": "playwright test tests/hermetic",
    "test:api": "playwright test tests/api",
    "test:e2e": "playwright test tests/e2e",
    "test:vibium": "playwright test tests/vibium",
    "test:hybrid": "playwright test tests/hybrid",
    "test:visual": "playwright test tests/visual",
    "test:cross-browser": "node scripts/run-browser-matrix.mjs",
    "test:stable": "node scripts/run-target.mjs stable",
    "test:with-bugs": "node scripts/run-target.mjs with-bugs",
    "healthcheck": "node scripts/check-target.mjs both",
    "healthcheck:api": "node scripts/check-target.mjs api",
    "healthcheck:site": "node scripts/check-target.mjs site",
    "report:build": "tsx scripts/build-report.ts",
    "dashboard:build": "tsx scripts/build-dashboard.ts",
    "lint": "oxlint --deny-warnings",
    "traceability": "tsx scripts/build-traceability.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true",
    "sut:up": "node scripts/sut.mjs up",
    "sut:down": "node scripts/sut.mjs down",
    "sut:reset": "node scripts/sut.mjs reset",
    "test:local": "node scripts/run-target.mjs local",
    "bdd:generate": "bddgen",
    "test:bdd": "bddgen && playwright test --project=bdd",
    "report:exit": "tsx scripts/build-exit-report.ts",
    "lighthouse:collect": "tsx scripts/run-lighthouse.ts",
    "lighthouse:report": "tsx scripts/build-lighthouse-report.ts"
  },
  "dependencies": {
    "vibium": "26.8.21"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint-plugin-playwright": "^2.12.2",
    "husky": "^9.1.7",
    "lighthouse": "13.6.0",
    "oxlint": "^1.93.0",
    "playwright-bdd": "9.2.1",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "vibium@26.8.21": true,
    "esbuild@0.28.2": true
  }
}
